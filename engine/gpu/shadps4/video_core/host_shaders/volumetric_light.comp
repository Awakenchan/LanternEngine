#version 450
#extension GL_EXT_scalar_block_layout : require

#ifdef TINT
layout(local_size_x = 1, local_size_y = 1) in;
#else
layout(local_size_x = 8, local_size_y = 8) in;
#endif

float depth_weight(vec4 fog, float depth) {
    if ((fog.a == 0.0) != (depth == 1.0)) return 0.0;
    float relative_depth = abs(fog.a - (1.0 - depth)) / max(1.0 - depth, 1e-6);
    return exp(-relative_depth * 80.0);
}

float sample_weight(vec4 fog, float depth, vec2 f, int x, int y) {
    float spatial = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
    return spatial * depth_weight(fog, depth);
}

#if defined(INTEGRATE) || defined(REPAIR)
layout(scalar, binding = 0) readonly buffer ShadowConstants { uint d[]; } cb;
layout(scalar, binding = 1) readonly buffer SceneConstants { uint d[]; } ub;
layout(binding = 2) uniform sampler2D depth_tex;
layout(binding = 3) uniform sampler2D shadow_tex;
layout(binding = 4, rgba16f) uniform writeonly image2D fog_out;
layout(binding = 5, r32f) uniform writeonly image2D depth_out;
#ifdef REPAIR
layout(binding = 6, rgba16f) uniform readonly image2D half_fog;
#endif

layout(push_constant) uniform Params {
    uint offsets;
    uint steps;
    float reach;
    float density;
    float strength;
    float anisotropy;
    float bias;
    float unused;
};

#ifdef REPAIR
#define GROUP
#else
#define GROUP shared
#endif
GROUP mat4 shared_inverse_projection;
GROUP mat4 shared_view_to_light[4];
GROUP vec3 shared_splits;
GROUP vec3 shared_direction;
GROUP vec2 shared_coverage;
GROUP uint shared_valid;

uint base;
float c(int i) { return uintBitsToFloat(cb.d[base + uint(i)]); }
vec4 row(int i) { return vec4(c(i), c(i + 1), c(i + 2), c(i + 3)); }

void prepare() {
    shared_inverse_projection = transpose(mat4(row(0), row(4), row(8), row(12)));
    mat4 projection = inverse(shared_inverse_projection);
    for (int i = 0; i < 4; ++i) {
        int m = 16 + 16 * i;
        shared_view_to_light[i] = transpose(mat4(row(m), row(m + 4), row(m + 8), row(m + 12))) * projection;
    }
    shared_splits = vec3(c(80), c(81), c(82));
    uint ubase = ((offsets >> 8) & 255u) >> 2;
    shared_coverage = uintBitsToFloat(uvec2(ub.d[ubase + 72u], ub.d[ubase + 73u]));
    mat4 light = shared_view_to_light[0];
    vec3 a = vec3(light[0][0], light[1][0], light[2][0]);
    vec3 b = vec3(light[0][1], light[1][1], light[2][1]);
    vec3 z = vec3(light[0][2], light[1][2], light[2][2]);
    vec3 direction = cross(a, b);
    shared_valid = 0u;
    if (any(isnan(direction)) || any(isinf(direction)) || dot(direction, direction) < 1e-16) return;
    direction = normalize(direction);
    shared_direction = dot(z, direction) > 0.0 ? -direction : direction;
    shared_valid = 1u;
}

mat4 local_light[4];
vec3 local_splits;

float visibility(vec3 p, vec2 texel) {
    int first = int(p.z > local_splits.x) + int(p.z > local_splits.y) + int(p.z > local_splits.z);
    for (int cascade = first; cascade < 4; ++cascade) {
        mat4 m = local_light[cascade];
        vec4 q = m * vec4(p, 1.0);
        if (abs(q.w) < 1e-8) return 0.0;
        vec3 s = q.xyz / q.w;
        vec2 lo = vec2(cascade & 1, cascade >> 1) * 0.5 + texel;
        vec2 hi = vec2(cascade & 1, cascade >> 1) * 0.5 + 0.5 - texel;
        if (any(lessThan(s.xy, lo)) || any(greaterThan(s.xy, hi))) continue;
        if (s.z < 0.0 || s.z > 1.0) return 0.0;
        vec3 zrow = vec3(m[0][2], m[1][2], m[2][2]);
        vec3 wrow = vec3(m[0][3], m[1][3], m[2][3]);
        float depth_bias = bias * length(zrow - s.z * wrow) / abs(q.w);
        vec4 lit = vec4(greaterThanEqual(textureGather(shadow_tex, s.xy, 0), vec4(s.z - depth_bias)));
        float coverage = clamp(shared_coverage.y * (shared_coverage.x - length(p)), 0.0, 1.0);
        return dot(lit, vec4(0.25)) * coverage;
    }
    return 0.0;
}

void main() {
    base = (offsets & 255u) >> 2;
#ifndef REPAIR
    if (gl_LocalInvocationIndex == 0u) prepare();
    barrier();
#endif

    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(fog_out);
    if (any(greaterThanEqual(px, size))) return;
#ifndef REPAIR
    ivec2 depth_size = imageSize(depth_out);
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 q = px * 2 + ivec2(x, y);
            if (any(greaterThanEqual(q, depth_size))) continue;
            float z = textureLod(depth_tex, (vec2(q) + 0.5) / vec2(depth_size), 0.0).r;
            imageStore(depth_out, q, vec4(z));
        }
    }
#endif
    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    float depth = textureLod(depth_tex, uv, 0.0).r;
    imageStore(fog_out, px, vec4(0.0, 0.0, 0.0, 1.0 - depth));
#ifdef REPAIR
    if (!(depth > 0.0 && depth <= 1.0)) return;
    ivec2 half_size = imageSize(half_fog);
    vec2 p = uv * vec2(half_size) - 0.5;
    ivec2 origin = ivec2(floor(p));
    vec2 f = fract(p);
    float weight_sum = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 q = clamp(origin + ivec2(x, y), ivec2(0), half_size - 1);
            weight_sum += sample_weight(imageLoad(half_fog, q), depth, f, x, y);
        }
    }

    if (weight_sum >= 1e-5) return;
    prepare();
#endif
    bool sky = depth == 1.0;
    if (shared_valid == 0u || !(depth > 0.0 && depth <= 1.0) || strength <= 0.0) return;

    vec4 h = shared_inverse_projection * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0,
                                              sky ? 0.5 : depth, 1.0);
    if (abs(h.w) < 1e-8) return;
    vec3 surface = h.xyz / h.w;
    if (!(surface.z > 0.0)) return;
    float distance_to_surface = length(surface);
    vec3 ray = surface / distance_to_surface;

    float g = anisotropy;
    float phase = (1.0 - g * g) /
                  pow(max(1.0 + g * g - 2.0 * g * dot(ray, shared_direction), 0.01), 1.5);
    float limit = sky ? reach : min(distance_to_surface, reach);
    float ds = limit / float(steps);

    float jitter = fract(52.9829189 * fract(dot(vec2(px), vec2(0.06711056, 0.00583715))));
    vec2 texel = 1.0 / vec2(textureSize(shadow_tex, 0));
    float energy = 0.0;
    local_light = shared_view_to_light;
    local_splits = shared_splits;
    for (uint i = 0u; i < steps; ++i) {
        float t = (float(i) + jitter) * ds;
        energy += exp(-density * t) * density * ds * visibility(ray * t, texel);
    }

    imageStore(fog_out, px, vec4(vec3(strength * phase * energy), 1.0 - depth));
}
#elif defined(TINT)
layout(scalar, binding = 0) readonly buffer Lighting { uint d[]; } lighting;
layout(scalar, binding = 1) buffer TintState { vec4 atmosphere; } state;
layout(push_constant) uniform TintParams {
    uint offset_bytes;
    uint record_count;
    float blend;
    uint skip_fallback;
};

vec3 record_vec3(uint id, uint field) {
    uint at = (offset_bytes >> 2) + id * 72u + field;
    return vec3(uintBitsToFloat(lighting.d[at]), uintBitsToFloat(lighting.d[at + 1u]),
                uintBitsToFloat(lighting.d[at + 2u]));
}

// A record that looks like a built-in default: pure white, no second light, a fixed direction, and
// the only lit record before an area's lights arrive. Table slots switch to it from frame to frame
// as the camera moves, and it would win over the area's lights.
bool is_fallback(uint id) {
    return record_vec3(id, 16u) == vec3(1.0) && record_vec3(id, 20u) == vec3(0.0) &&
           all(lessThan(abs(record_vec3(id, 0u) - vec3(0.70710678, 0.70710678, 0.0)), vec3(1e-3)));
}

vec3 primary(uint id) {
    vec3 rgb = record_vec3(id, 16u);
    if (any(isnan(rgb)) || any(isinf(rgb))) return vec3(0.0);
    rgb = max(rgb, vec3(0.0));

    return rgb / max(1.0, max(rgb.r, max(rgb.g, rgb.b)));
}

bool brighter(vec4 a, vec4 b) {
    if (a.w != b.w) return a.w > b.w;
    if (a.r != b.r) return a.r > b.r;
    if (a.g != b.g) return a.g > b.g;
    return a.b > b.b;
}

void main() {
    vec4 best = vec4(0.0);
    bool has_fallback = false;
    for (uint id = 0u; id < record_count; ++id) {
        if (skip_fallback != 0u && is_fallback(id)) {
            has_fallback = true;
            continue;
        }
        vec3 rgb = primary(id);
        vec4 candidate = vec4(rgb, dot(rgb, vec3(0.2126, 0.7152, 0.0722)));
        if (brighter(candidate, best)) best = candidate;
    }
    if (best.w == 0.0 && has_fallback) best = vec4(1.0);
    vec3 target = mix(vec3(best.w), best.rgb, 0.75);
    // The area's lights also come and go with the camera, so the color fades to its new value. At
    // blend 1 the buffer may hold nothing valid yet.
    state.atmosphere = vec4(blend >= 1.0 ? target : mix(state.atmosphere.rgb, target, blend), 1.0);
}
#elif defined(FILTER)
layout(binding = 0) uniform sampler2D fog_src;
layout(binding = 1, rgba16f) uniform writeonly image2D fog_dst;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = textureSize(fog_src, 0);
    if (any(greaterThanEqual(px, size))) return;
    vec4 centre = texelFetch(fog_src, px, 0);
    float depth = 1.0 - centre.a;
    vec3 sum = vec3(0.0);
    float weight_sum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec4 fog = texelFetch(fog_src, clamp(px + ivec2(x, y), ivec2(0), size - 1), 0);
            float w = depth_weight(fog, depth);
            sum += fog.rgb * w;
            weight_sum += w;
        }
    }
    imageStore(fog_dst, px, vec4(weight_sum > 1e-5 ? sum / weight_sum : centre.rgb, centre.a));
}
#elif defined(COMPOSITE)
layout(binding = 0) uniform sampler2D fog_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2, rgba16f) uniform image2D scene;
layout(scalar, binding = 3) readonly buffer TintState { vec4 atmosphere; } state;
layout(binding = 4) uniform sampler2D repair_tex;
layout(binding = 5) uniform sampler2D point_tex;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(scene);
    if (any(greaterThanEqual(px, size))) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);
    float depth = textureLod(depth_tex, uv, 0.0).r;
    if (!(depth > 0.0 && depth <= 1.0)) return;
    ivec2 half_size = textureSize(fog_tex, 0);
    vec2 p = uv * vec2(half_size) - 0.5;
    ivec2 origin = ivec2(floor(p));
    vec2 f = fract(p);
    vec3 sum = vec3(0.0);
    float weight_sum = 0.0;
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 q = clamp(origin + ivec2(x, y), ivec2(0), half_size - 1);
            vec4 fog = texelFetch(fog_tex, q, 0);
            float w = sample_weight(fog, depth, f, x, y);
            sum += fog.rgb * w;
            weight_sum += w;
        }
    }
    vec3 scattering = weight_sum < 1e-5 ? texelFetch(repair_tex, px, 0).rgb : sum / weight_sum;
    vec4 color = imageLoad(scene, px);
    imageStore(scene, px, vec4(color.rgb + scattering * state.atmosphere.rgb +
                                   texelFetch(point_tex, px, 0).rgb, color.a));
}
#endif
