# Copy to .env and enter the domain pointing directly to your VPS.
# Use only the domain, without https://, a path, or a port. HTTPS uses TCP 443.
RELAY_DOMAIN=coop.example.com

# Docker project name for this group of containers and volumes.
COMPOSE_PROJECT_NAME=private-coop-docker

# Log rotation for each container.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3

# Generated automatically by setup from the host's invitation code.
ROOM_ID=
